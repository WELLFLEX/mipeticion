# Local development works without credentials (template drafting and PDF).
# Never prefix secrets with NEXT_PUBLIC_. Do not commit .env.local.
APP_URL=http://localhost:3000
TRACKING_ENABLED=false
PRIVACY_OPERATOR=
# Proposed contact: verify the mailbox and name the actual operator before enabling accounts.
PRIVACY_EMAIL=info@mipeticion.co

# Supabase: a dedicated project with both migrations applied.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate independent random secrets with: openssl rand -hex 32
RATE_LIMIT_SECRET=
CRON_SECRET=
BETA_LIMIT=50
# Set only behind a proxy you control; Vercel uses its trusted forwarding header.
TRUST_PROXY=false

# Optional AI. Positive prices must match the chosen model's current published rates.
# No key/model/prices/shared budget = explicitly labeled template fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=
AI_INPUT_USD_PER_M=
AI_OUTPUT_USD_PER_M=
AI_MONTHLY_BUDGET_USD=25

# Verify the sender domain, configure Supabase custom SMTP, and use the OTP template.
RESEND_API_KEY=
MAIL_FROM=
